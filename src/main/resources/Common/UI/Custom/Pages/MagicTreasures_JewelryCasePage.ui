$C = "../Common.ui";

// The Jewelry Case page (Nov 11), opened by right-clicking the case
// (JewelryCasePage.java). The top row is what the case holds: two
// rings, a necklace and a bracelet, each slot with a picture of what
// goes in it. Below are the pieces the player carries. Moving is by
// click: each slot is a one-slot ItemGrid with an invisible Button
// over it, because page item grids don't send clicks or take drags.
// The button carries the piece's tooltip (it covers the grid's own).
// Generated once by hand; keep the ids in step with the Java.

@Slot = 74;

@Grid = ItemGridStyle(
  SlotSize: @Slot,
  SlotIconSize: 64,
  SlotSpacing: 2,
  SlotBackground: "MagicTreasures/CaseSlot_Plain.png"
);

@Label = (FontSize: 14, TextColor: #c9d2dd);
@Hint = (FontSize: 13, TextColor: #8f9bab);

$C.@PageOverlay {}

$C.@DecoratedContainer {
  Anchor: (Width: 730, Height: 440);

  #Title {
    Group {
      $C.@Title {
        @Text = %server.customUI.mtJewelryCase.title;
      }
    }
  }

  #Content {
    LayoutMode: Top;

    Label {
      Text: %server.customUI.mtJewelryCase.worn;
      Style: @Label;
    }
    Group {
      LayoutMode: Left;
      Anchor: (Height: @Slot + 4);
      Group {
        Anchor: (Width: @Slot + 2, Height: @Slot + 2);
        ItemGrid #WornGrid0 {
          Anchor: (Width: @Slot + 2, Height: @Slot + 2, Horizontal: 0, Vertical: 0);
          SlotsPerRow: 1;
          Style: (...@Grid, SlotBackground: "MagicTreasures/CaseSlot_Ring.png");
        }
        Button #WornButton0 {
          Anchor: (Width: @Slot, Height: @Slot, Horizontal: 0, Vertical: 0);
          TextTooltipStyle: $C.@DefaultTextTooltipStyle;
        }
      }
      Group {
        Anchor: (Width: @Slot + 2, Height: @Slot + 2);
        ItemGrid #WornGrid1 {
          Anchor: (Width: @Slot + 2, Height: @Slot + 2, Horizontal: 0, Vertical: 0);
          SlotsPerRow: 1;
