$C = "../Common.ui";

$C.@PageOverlay {}

$C.@DecoratedContainer {
  Anchor: (Width: 640, Height: 420);

  #Title {
    Group {
      $C.@Title {
        @Text = %server.customUI.mtImbuePage.title;
      }
    }
  }

  #Content {
    Label #Subtitle {
      Padding: (Bottom: 8);
      Text: "";
      Style: (TextColor: #e8c96a);
    }

    Group {
      LayoutMode: Left;
      Padding: (Right: 15, Bottom: 5);

      Label {
        FlexWeight: 1;
        Text: %server.customUI.mtImbuePage.item;
        Style: (RenderBold: true);
      }

      Label {
        Text: %server.customUI.mtImbuePage.result;
        Style: (RenderBold: true);
      }
    }

    Group #ElementList {
      FlexWeight: 1;
      LayoutMode: TopScrolling;
      ScrollbarStyle: $C.@DefaultScrollbarStyle;
    }
  }
}

$C.@BackButton {}
